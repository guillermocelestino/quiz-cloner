# PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# NVIDIA build.nvidia.com API credentials (server-side only, NEVER exposed to the browser)
NVIDIA_API_KEY=

# NVIDIA models
NVIDIA_OCR_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: when set to "1", forces demo mode (deterministic sample data) even if a key is present
NVIDIA_DEMO_MODE=0
